import java.util.*;

public class starter {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int random=(int)(Math.random()*5+2);
        System.out.println("You are going to make a band");
        System.out.print("Enter your bands name: ");
        String name=sc.nextLine();
        System.out.print("Input the number of people in your band (2-6): ");
        int bandnumber=sc.nextInt();
        sc.nextLine();
        System.out.print("Type the name of the song you want them to play at their concert: ");
        String song=sc.nextLine();
        if (random==2){
        System.out.print("Please input their names (name1,name2,etc.): ");
        String membernames=sc.nextLine();
        System.out.println("Your bands name is "+name+" and the names of the members are "+membernames+".");
        System.out.println("The song your band is playing is "+song);
        }
        else if (random==3){
        System.out.print("Please input their names (name1,name2,etc.): ");
        String membernames=sc.nextLine();
        System.out.println("Your bands name is "+name+" and the names of the members are "+membernames+".");
         System.out.println("The song your band is playing is "+song+" (slowed)");
        }
        else if (random==4){
        System.out.print("Please input their names (name1,name2,etc.): ");
        String membernames=sc.nextLine();
        System.out.println("Your bands name is "+name+" and the names of the members are "+membernames+".");
        System.out.println("Congrats! The song that your band wil be playing is "+song+" (slowed + reverb)");
        }else if (random==5){
        System.out.print("Please input their names (name1,name2,etc.): ");
        String membernames=sc.nextLine();
        System.out.println("Your bands name is "+name+" and the names of the members are "+membernames+".");
         System.out.println("The song your band is playing is "+song+" (slowed+reverb+phonk)");
        }
        else if (random==6){
        System.out.print("Please input their names (name1,name2,etc.): ");
        String membernames=sc.nextLine();
        System.out.println("Your bands name is "+name+" and the names of the members are "+membernames+".");
         System.out.println("The song your band is playing is "+song+" (slowed+reverb+phonk+sped up)");
        }
        System.out.println("Thank you for coming to "+name+"s concert.");
    }
}